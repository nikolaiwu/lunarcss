{
  "name": "@nikolaiwu/lunarcss",
  "version": "0.2.0",
  "description": "A plug-and-play CSS theme that styles all standard HTML elements using pure element selectors, no classes.",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "style": "dist/lunarcss.min.css",
  "types": "types/stylesheet.d.ts",
  "exports": {
    ".": {
      "types": "./types/stylesheet.d.ts",
      "default": "./dist/lunarcss.min.css"
    },
    "./fonts": {
      "types": "./types/stylesheet.d.ts",
      "default": "./dist/lunarcss-fonts.min.css"
    },
    "./layout": {
      "types": "./types/stylesheet.d.ts",
      "default": "./dist/lunarcss-layout.min.css"
    },
    "./scss": "./src/scss/main.scss",
    "./scss/layout": "./src/scss/layout.scss",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/lunarcss.min.css",
    "dist/lunarcss-fonts.min.css",
    "dist/lunarcss-layout.min.css",
    "dist/fonts",
    "src/scss",
    "types",
    "!src/scss/showcase.scss",
    "!src/scss/showcase",
    "!src/scss/fonts.scss"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "pnpm build",
    "release:patch": "npm version patch -m \"Release v%s\"",
    "release:minor": "npm version minor -m \"Release v%s\"",
    "release:major": "npm version major -m \"Release v%s\""
  },
  "keywords": [
    "css",
    "theme",
    "classless",
    "minimal",
    "dark-mode",
    "light-mode",
    "scss",
    "html",
    "styling"
  ],
  "author": "Nikolai Vuchkov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikolaiwu/lunarcss.git"
  },
  "homepage": "https://github.com/nikolaiwu/lunarcss#readme",
  "bugs": {
    "url": "https://github.com/nikolaiwu/lunarcss/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "node-html-parser": "^9.0.4",
    "prettier": "^3.9.6",
    "sass": "^1.77.0",
    "shiki": "^4.4.3",
    "vite": "^5.4.0"
  }
}
